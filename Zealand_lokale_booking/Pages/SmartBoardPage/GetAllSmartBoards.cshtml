@page
@model Zealand_lokale_booking.Pages.SmartBoardPage.GetAllSmartBoardsModel

<div class="container mt-5">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">SmartBoards</h2>

            <a asp-page="/SmartBoardPage/CreateSmartBoard" class="btn btn-success">
                + Opret SmartBoard
            </a>
        </div>

        <div class="card-body">

            @if (Model.SmartBoards.Any())
            {
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                    <tr>
                        <th>Navn</th>
                        <th>Størrelse</th>
                        <th>Beskrivelse</th>
                        <th>Lokale</th>
                        <th>Status</th>
                        <th>Handlinger</th>
                    </tr>
                    </thead>

                    <tbody>
                    @foreach (var smartBoard in Model.SmartBoards)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @smartBoard.SmartBoardName
                            </td>

                            <td>
                                @smartBoard.SizeInches"
                            </td>

                            <td class="text-start">
                                @smartBoard.Description
                            </td>

                            <td>
                                @if (smartBoard.Room != null)
                                {
                                    @smartBoard.Room.RoomName
                                }
                                else
                                {
                                    <span class="text-muted">Ingen lokale tilknyttet</span>
                                }
                            </td>

                            <td>
                                @if (smartBoard.Availability)
                                {
                                    <span class="badge bg-success">Tilgængelig</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ikke tilgængelig</span>
                                }
                            </td>

                            <td>
                                <a asp-page="/SmartBoardPage/EditSmartBoard"
                                   asp-route-id="@smartBoard.SmartBoardId"
                                   class="btn btn-warning btn-sm">
                                    Rediger
                                </a>

                                <a asp-page="/SmartBoardPage/DeleteSmartBoard"
                                   asp-route-id="@smartBoard.SmartBoardId"
                                   class="btn btn-danger btn-sm">
                                    Slet
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    Der findes ingen SmartBoards endnu.
                </div>
            }

        </div>

    </div>

</div>