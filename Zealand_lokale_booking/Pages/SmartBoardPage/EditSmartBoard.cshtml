@page
@model Zealand_lokale_booking.Pages.SmartBoardPage.EditSmartBoardModel

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width:700px;">

        <div class="card-header bg-warning">
            <h2 class="mb-0">Rediger SmartBoard</h2>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden"
                       asp-for="SmartBoard.SmartBoardId" />

                <div class="mb-3">
                    <label class="form-label">
                        SmartBoard navn
                    </label>

                    <input asp-for="SmartBoard.SmartBoardName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Størrelse (tommer)
                    </label>

                    <input asp-for="SmartBoard.SizeInches"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Beskrivelse
                    </label>

                    <textarea asp-for="SmartBoard.Description"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Lokale
                    </label>

                    <select asp-for="SmartBoard.RoomId"
                            asp-items="Model.RoomOptions"
                            class="form-control">

                        <option value="">
                            Ingen lokale tilknyttet
                        </option>

                    </select>
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="SmartBoard.Availability"
                            class="form-control">

                        <option value="true">
                            Tilgængelig
                        </option>

                        <option value="false">
                            Ikke tilgængelig
                        </option>

                    </select>

                </div>

                <div class="d-flex justify-content-between">

                    <a asp-page="/SmartBoardPage/GetAllSmartBoards"
                       class="btn btn-secondary">
                        Tilbage
                    </a>

                    <button type="submit"
                            class="btn btn-warning">
                        Gem ændringer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>