@page "{id:int}"
@model Zealand_lokale_booking.Pages.SmartBoardPage.EditSmartBoardModel

<h2>Rediger SmartBoard</h2>

<form method="post">

    <input type="hidden"
           asp-for="SmartBoard.SmartBoardId" />

    <div class="mb-3">
        <label>Navn</label>
        <input asp-for="SmartBoard.SmartBoardName"
               class="form-control"/>
    </div>

    <div class="form-check mb-3">
        <input asp-for="SmartBoard.Availability"
               class="form-check-input"/>

        <label class="form-check-label">
            Tilgængelig
        </label>
    </div>

    <button class="btn btn-success">
        Gem
    </button>

</form>