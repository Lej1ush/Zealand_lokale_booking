@page
@model Zealand_lokale_booking.Pages.SmartBoardPage.CreateSmartBoardModel

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-success text-white">
            <h2 class="mb-0">Opret SmartBoard</h2>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">SmartBoard navn</label>
                    <input asp-for="SmartBoard.SmartBoardName"
                           class="form-control"
                           placeholder="Fx SmartBoard 75&quot; Promethean" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Størrelse (tommer)</label>
                    <input asp-for="SmartBoard.SizeInches"
                           class="form-control"
                           placeholder="Fx 75" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Beskrivelse</label>
                    <textarea asp-for="SmartBoard.Description"
                              class="form-control"
                              rows="4"
                              placeholder="Beskriv SmartBoardets funktion og anvendelse"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Lokale</label>
                    <select asp-for="SmartBoard.RoomId"
                            asp-items="Model.RoomOptions"
                            class="form-control">
                        <option value="">Ingen tilknytning</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <select asp-for="SmartBoard.Availability"
                            class="form-control">
                        <option value="true">Tilgængelig</option>
                        <option value="false">Ikke tilgængelig</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">

                    <a asp-page="/SmartBoardPage/GetAllSmartBoards"
                       class="btn btn-secondary">
                        Annuller
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        Opret SmartBoard
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>