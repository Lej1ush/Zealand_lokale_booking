@page
@model Zealand_lokale_booking.Pages.UserPage.CreateUserModel
@{
}
<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="fa fa-user-plus me-2"></i>
                Opret bruger</h5>
        </div>

        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post" enctype="multipart/form-data">

                <!-- Navn -->
                <div class="mb-3">
                    <label class="form-label">Navn</label>
                    <input asp-for="User.Name" class="form-control" required />
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="User.Email" class="form-control" required />
                    <small class="text-muted">
                        Studerende: @@edu.zealand.dk | Undervisere: @@zealand.dk
                    </small>
                </div>

                <!-- Adgangskode -->
                <div class="mb-3">
                    <label class="form-label">Adgangskode</label>
                    <input asp-for="User.Password" class="form-control" required />
                </div>
                <!-- Foto -->
                <div class="mb-3">

                    <label class="form-label">
                        <i class="fa fa-image me-1"></i>
                        Foto
                    </label>

                    <input type="file"
                           asp-for="ImageFile"
                           class="form-control" />

                </div>
                <!-- Rolle -->
                <div class="mb-3">
                    <select asp-for="User.RoleId" class="form-select">

                        <option value="">Vælg rolle</option>
                        <option value="3">Underviser</option>
                        <option value="2">Studerende</option>

                    </select>
                </div>

                <!-- Knapper -->
                <div class="d-flex justify-content-between">
                    <a asp-page="/UserPage/GetAllUsers" class="btn btn-secondary">
                        <i class="fa fa-times me-1"></i> Annuller</a>

                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-check me-1"></i> Opret </button>
                </div>

            </form>
        </div>
    </div>
    </div>