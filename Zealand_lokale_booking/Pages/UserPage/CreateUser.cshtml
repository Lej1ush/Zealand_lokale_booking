@page
@model Zealand_lokale_booking.Pages.UserPage.CreateUserModel
@{
}
<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="fa fa-user-plus me-2"></i>
                Opret bruger</h5>
        </div>

        <div class="card-body">
          

            <form method="post" enctype="multipart/form-data">

                <!-- Navn -->
                <div class="form-group  mb-4">
                    <label asp-for="User.Name" class="control-label"></label>
                    <input asp-for="User.Name" class="form-control" />
                    <span asp-validation-for="User.Name" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="form-group mb-4">
                    <label asp-for="User.Email" class="control-label"></label>
                    <input asp-for="User.Email" class="form-control" />

                    <small class="text-muted d-block">
                        Studerende: @@edu.zealand.dk | Undervisere: @@zealand.dk
                    </small>

                    <span asp-validation-for="User.Email" class="text-danger d-block"></span>
                </div>

                <!-- Adgangskode -->
                <div class="form-group  mb-4">
                    <label asp-for="User.Password" class="control-label"></label>
                    <input asp-for="User.Password" class="form-control" />
                    <span asp-validation-for="User.Password" class="text-danger"></span>
                </div>
                <!-- Foto -->
                <div class="form-group  mb-4">
                    <label asp-for="ImageFile" class="control-label"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                </div>
                <!-- Rolle -->
                <div class="form-group  mb-4">
                    <label asp-for="User.RoleId" class="control-label"></label>

                    <select asp-for="User.RoleId" class="form-control">
                        <option value="0">Vælg rolle</option>
                        <option value="2">Studerende</option>
                        <option value="3">Underviser</option>
                    </select>

                    <span asp-validation-for="User.RoleId" class="text-danger"></span>
                </div>

                <!-- Knapper -->
                <div class="d-flex justify-content-between mt-3">
                    <a asp-page="/UserPage/GetAllUsers" class="btn btn-secondary">
                        <i class="fa fa-times me-1"></i> Annuller</a>

                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-check me-1"></i> Opret </button>
                </div>

            </form>
        </div>
    </div>
 