@page
@using Zealand_lokale_booking.Models
@model Zealand_lokale_booking.Pages.UserPage.GetAllUsersModel
@{
}

<div class="container mt-4">

    <div class="content-box">

        <h2 class="mb-4">

            @if (Model.Role == null)
            {
                <text>Alle brugere</text>
            }
            else if (Model.Role == 2)
            {
                <text>Studerende</text>
            }
            else if (Model.Role == 3)
            {
                <text>Undervisere</text>
            }

        </h2>

        <div class="row g-3 mb-4">

            <!-- SEARCH BY NAME -->

            <div class="col-12 col-md-4">

                <form method="post">

                    <div class="input-group">

                        <input asp-for="SearchString"
                               class="form-control shadow-sm rounded-pill"
                               placeholder="Søg efter navn" />

                        <button type="submit"
                                asp-page-handler="NameSearch"
                                class="btn btn-primary rounded-pill ms-2 px-4">

                            <i class="fa fa-search"></i>

                        </button>

                    </div>

                </form>

            </div>

            <!-- SEARCH BY ID -->

            <div class="col-12 col-md-4">

                <form method="post">

                    <div class="input-group">

                        <input asp-for="SearchId"
                               class="form-control"
                               placeholder="Søg efter ID" />

                        <button type="submit"
                                asp-page-handler="IdSearch"
                                class="btn btn-secondary">

                            <i class="fa fa-search"></i>

                        </button>

                    </div>

                </form>

            </div>

              

        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover table-striped align-middle text-center shadow-lg">
                <colgroup>

                    <col style="width:7%">
                    <col style="width:18%">
                    <col style="width:25%">
                    <col style="width:15%">
                    <col style="width:15%">
                    <col style="width:20%">

                </colgroup>

                <thead class="table-dark">

                    <tr>

                        <th>

                            <div class="d-flex justify-content-between">

                                <span>Id</span>

                                <span class="ms-1">

                                    <a asp-page-handler="SortById"
                                       asp-route-role="@Model.Role"
                                       class="text-white text-decoration-none small">
                                        <i class="fa fa-sort-up"></i>
                                    </a>

                                    <a asp-page-handler="SortByIdDesc"
                                       asp-route-role="@Model.Role"
                                       class="text-white text-decoration-none small ms-1">
                                        <i class="fa fa-sort-down"></i>
                                    </a>

                                </span>

                            </div>

                        </th>

                        <th>

                            <div class="d-flex justify-content-between">

                                <span>Navn</span>

                                <span class="ms-1">

                                    <a asp-page-handler="SortByName"
                                       asp-route-role="@Model.Role"
                                       class="text-white text-decoration-none small">
                                        <i class="fa fa-sort-up"></i>
                                    </a>
                                    <a asp-page-handler="SortByNameDesc"
                                       asp-route-role="@Model.Role"
                                       class="text-white text-decoration-none small ms-1">
                                        <i class="fa fa-sort-down"></i>
                                    </a>

                                </span>

                            </div>

                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Rolle
                        </th>
                        <th>Foto</th>

                        <th>
                            Valg
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Users != null && Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>

                                <td>
                                    @user.UserId
                                </td>

                                <td>
                                    @user.Name
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>

                                    <span class="badge rounded-pill px-3 py-2 @(user.Role?.RoleName == "Admin" ? "bg-danger" : user.Role?.RoleName == "Teacher" ? "bg-primary" : "bg-success")">
                                                                             @*   @user.Role?.RoleName *@
                                        @(user.Role?.RoleName == "Admin" ? "Administrator" :user.Role?.RoleName == "Teacher" ? "Underviser" : "Studerende")

                                    </span>

                                </td>
                                <td>
                                    <img src="@user.ImagePath"
                                         width="60"
                                         height="60"
                                         class="rounded-circle object-fit-cover" />
                                </td>
                                <td>

                                    <div class="d-flex justify-content-center gap-2">

                                        <a class="btn btn-warning btn-sm rounded-pill"
                                           asp-page="/UserPage/EditUser"
                                           asp-route-id="@user.UserId">

                                            <i class="fa fa-edit me-1"></i>
                                            Rediger

                                        </a>

                                        <a class="btn btn-danger btn-sm rounded-pill"
                                           asp-page="/UserPage/DeleteUser"
                                           asp-route-id="@user.UserId">

                                            <i class="fa fa-trash me-1"></i>
                                            Slet

                                        </a>

                                    </div>

                                </td>

                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5">
                                Ingen brugere fundet
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-4">

            <a asp-page="/LogInPage/AdminDashBoard"
               class="btn btn-secondary rounded-pill px-4">

                <i class="fa fa-arrow-left me-1"></i>
                Tilbage

            </a>

        </div>

    </div>

</div>