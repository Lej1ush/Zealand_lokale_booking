@page
@model Zealand_lokale_booking.Pages.UserPage.UserDashBoard

<div class="dashboard-wrapper">
    <div class="dashboard-box">

        <h1>Velkommen</h1>
        <p>Vælg en funktion</p>

        <div class="dashboard-links">

            <a asp-page="/BookingPage/GetAllBookings" class="dash-btn blue">
                Bookinger
            </a>

            <a asp-page="/RoomPage/GetAllRooms" class="dash-btn green">
                Lokaler
            </a>

            <a asp-page="/BookingPage/CreateBooking" class="dash-btn orange">
                Opret booking
            </a>
        
        </div>

        <a asp-page="/Index" class="back-btn">
            Tilbage
        </a>

    </div>
</div>

<style>

.dashboard-wrapper{
    min-height:70vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.dashboard-box{
    background:white;
    width:650px;
    padding:60px;
    border-radius:25px;
    text-align:center;
    box-shadow:0 8px 25px rgba(0,0,0,0.15);
}

.dashboard-box h1{
    font-size:65px;
    margin-bottom:10px;
}

.dashboard-box p{
    font-size:25px;
    color:gray;
    margin-bottom:35px;
}

.dashboard-links{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:20px;
}

.dash-btn{
    width:260px;
    padding:20px;
    border-radius:15px;
    text-decoration:none;
    color:white;
    font-size:22px;
    font-weight:bold;
}

.blue{
    background:#2525e6;
}

.green{
    background:#23a73c;
}

.orange{
    background:#d97706;
}

.back-btn{
    display:inline-block;
    margin-top:30px;
    border:1px solid black;
    padding:10px 20px;
    border-radius:8px;
    text-decoration:none;
    color:black;
}

</style>