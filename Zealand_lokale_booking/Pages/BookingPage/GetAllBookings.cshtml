@page
@model Zealand_lokale_booking.Pages.BookingPage.GetAllBookingsModel

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Alle bookinger</h3>
        </div>

        <div class="card-body">

            @if (Model.Bookings.Any())
            {
                <table class="table table-hover align-middle text-center">

                    <thead class="table-light">
                    <tr>
                        <th>Booking ID</th>
                        <th>Bruger</th>
                        <th>Lokale</th>
                        <th>Rumtype</th>
                        <th>Dato</th>
                        <th>Start</th>
                        <th>Slut</th>
                        <th>Status</th>
                        <th>Handling</th>
                    </tr>
                    </thead>

                    <tbody>

                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>

                            <td>@booking.BookingId</td>

                            <td>@booking.User?.Email</td>

                            <td>@booking.Room?.RoomName</td>

                            <td>@booking.Room?.RoomType?.TypeName</td>

                            <td>@booking.BookingDate.ToShortDateString()</td>

                            <td>@booking.StartTime.ToString("HH:mm")</td>

                            <td>@booking.EndTime.ToString("HH:mm")</td>

                            <td>
                                @if (booking.Status)
                                {
                                    <span class="badge bg-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Aflyst</span>
                                }
                            </td>

                            <td>
                                <a class="btn btn-warning btn-sm"
                                   asp-page="/BookingPage/EditBooking"
                                   asp-route-id="@booking.BookingId">
                                    Rediger
                                </a>

                                <a class="btn btn-danger btn-sm"
                                   asp-page="/BookingPage/DeleteBooking"
                                   asp-route-id="@booking.BookingId">
                                    Slet
                                </a>
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>
            }
            else
            {
                <p class="text-muted">
                    Der er ingen bookinger endnu.
                </p>
            }

        </div>

    </div>
</div>