@page "{id:int}"
@model Zealand_lokale_booking.Pages.Roompage.DeleteRoomModel

<h2>Slet lokale</h2>

<div class="alert alert-danger">

    Er du sikker på at du vil slette:

    <strong>@Model.Room.RoomName</strong> ?

</div>

<form method="post">

    <button type="submit" class="btn btn-danger">
        Slet
    </button>

    <a asp-page="/Roompage/GetAllRooms"
       class="btn btn-secondary">

        Annuller

    </a>

</form>