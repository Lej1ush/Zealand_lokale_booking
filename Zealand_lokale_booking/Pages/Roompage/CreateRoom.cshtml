@page
@model Zealand_lokale_booking.Pages.Roompage.CreateRoomModel

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-success text-white">
            <h2 class="mb-0">Opret lokale</h2>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Lokale navn</label>
                    <input asp-for="Room.RoomName"
                           class="form-control"
                           placeholder="Fx A101, B202 eller C303" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Kapacitet</label>
                    <select asp-for="Room.Capacity" class="form-control">
                        <option value="">Vælg kapacitet</option>
                        <option value="4">4 personer</option>
                        <option value="8">8 personer</option>
                        <option value="12">12 personer</option>
                        <option value="20">20 personer</option>
                        <option value="30">30 personer</option>
                        <option value="50">50 personer</option>
                        <option value="100">100 personer</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Etage</label>
                    <select asp-for="Room.Floor" class="form-control">
                        <option value="">Vælg etage</option>
                        <option value="0">Stueetage</option>
                        <option value="1">1. sal</option>
                        <option value="2">2. sal</option>
                        <option value="3">3. sal</option>
                        <option value="4">4. sal</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Bygning</label>
                    <select asp-for="Room.BuildingId"
                            asp-items="Model.BuildingOptions"
                            class="form-control">
                        <option value="">Vælg bygning</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Lokaletype</label>

                    <select asp-for="Room.RoomTypeId"
                            asp-items="Model.RoomTypeOptions"
                            class="form-control">
                        <option value="">Vælg lokaletype</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label">SmartBoard</label>
                    <select asp-for="Room.SmartBoardId"
                            asp-items="Model.SmartBoardOptions"
                            class="form-control">
                        <option value="">Vælg SmartBoard</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="/Roompage/GetAllRooms" class="btn btn-secondary">
                        Annuller
                    </a>

                    <button type="submit" class="btn btn-success">
                        Opret lokale
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>