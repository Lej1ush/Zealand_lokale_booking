@page
@model Zealand_lokale_booking.Pages.Roompage.GetAllRoomsModel

<div class="container mt-5">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Alle lokaler</h2>

            <a asp-page="/Roompage/CreateRoom" class="btn btn-success">
                + Opret lokale
            </a>
        </div>

        <div class="card-body">

            @if (Model.Rooms.Any())
            {
                <table class="table table-hover align-middle text-center">

                    <thead class="table-light">
                    <tr>
                        <th>Lokale</th>
                        <th>Kapacitet</th>
                        <th>Etage</th>
                        <th>Bygning</th>
                        <th>Lokaletype</th>
                        <th>Handlinger</th>
                    </tr>
                    </thead>

                    <tbody>

                    @foreach (var room in Model.Rooms)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @room.RoomName
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @room.Capacity personer
                                </span>
                            </td>

                            <td>
                                @if (room.Floor == 0)
                                {
                                    <span>Stueetage</span>
                                }
                                else
                                {
                                    <span>@room.Floor. sal</span>
                                }
                            </td>

                            <td>
                                @(room.Building != null
                                    ? $"{room.Building.BuildingName} - {room.Building.Address}"
                                    : "Ingen bygning")
                            </td>

                            <td>
                                @(room.RoomType != null
                                    ? room.RoomType.TypeName
                                    : "Ingen type")
                            </td>

                            <td>

                                <a asp-page="/BookingPage/CreateBooking"
                                   asp-route-roomId="@room.RoomId"
                                   class="btn btn-primary btn-sm">
                                    Book lokale
                                </a>

                                <a asp-page="/Roompage/EditRoom"
                                   asp-route-id="@room.RoomId"
                                   class="btn btn-warning btn-sm">
                                    Rediger
                                </a>

                                <a asp-page="/Roompage/DeleteRoom"
                                   asp-route-id="@room.RoomId"
                                   class="btn btn-danger btn-sm">
                                    Slet
                                </a>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>
            }
            else
            {
                <div class="alert alert-info">
                    Der findes ingen lokaler endnu.
                </div>
            }

        </div>

    </div>

</div>