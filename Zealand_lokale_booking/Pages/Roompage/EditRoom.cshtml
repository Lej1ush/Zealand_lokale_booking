@page "{id:int}"
@model Zealand_lokale_booking.Pages.Roompage.EditRoomModel

<div class="container mt-5">

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">

        <div class="card-header bg-warning">
            <h2 class="mb-0">Rediger lokale</h2>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden" asp-for="Room.RoomId" />

                <div class="mb-3">
                    <label class="form-label">Lokale navn</label>
                    <input asp-for="Room.RoomName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Kapacitet</label>
                    <input asp-for="Room.Capacity" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Etage</label>
                    <input asp-for="Room.Floor" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Building Id</label>
                    <input asp-for="Room.BuildingId" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Room Type Id</label>
                    <input asp-for="Room.RoomTypeId" class="form-control" />
                </div>

                <div class="alert alert-info">
                    SmartBoards redigeres og tilknyttes under SmartBoard-siden, så ikke alle lokaler behøver at have et SmartBoard.
                </div>

                <div class="d-flex justify-content-between">

                    <a asp-page="/Roompage/GetAllRooms" class="btn btn-secondary">
                        Annuller
                    </a>

                    <button type="submit" class="btn btn-success">
                        Gem
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>