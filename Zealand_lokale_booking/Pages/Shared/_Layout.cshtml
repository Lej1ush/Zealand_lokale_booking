<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zealand_lokale_booking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lokalBooking.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zealand_lokale_booking.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
    <header>
        @{
            var isHome = Context.Request.Path == "/";   //er hjem?
        }
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ZealandLokaleBooking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-hjem text-white fw-semibold"
                               asp-area=""
                               asp-page="/Index">

                                Hjem
                            </a>
                        </li>
                        
                        @* 
<li class="nav-item">
    <a class="nav-link text-dark" asp-page="/BookingPage/GetALLBookings">
        Bookinger
    </a>
</li>

<li class="nav-item">
    <a class="nav-link text-dark" asp-page="/Roompage/GetAllRooms">
        Lokaler
    </a>
</li>

<li class="nav-item">
    <a class="nav-link text-dark" asp-page="/BookingPage/CreateBooking">
        Opret booking
    </a>
</li>
*@


                    </ul>
                    


                    <!-- RIGHT -->

                    <ul class="navbar-nav ms-auto d-flex flex-column flex-lg-row gap-2 align-items-start align-items-lg-center">

                        @using System.Security.Claims

                        @{
                            var role = User.FindFirst(ClaimTypes.Role)?.Value;
                        }
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin") && !isHome)
                        {
                            <li class="nav-item">
                                <span class="nav-link fw-semibold text-white">
                                    <i class="fa fa-user-circle me-1"></i> Administrator
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-success nav-btn"
                                   asp-page="/UserPage/CreateUser">
                                    <i class="fa fa-user-plus me-1"></i>
                                    Opret bruger
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-success nav-btn"
                                   asp-page="/Roompage/CreateRoom">
                                   <i class="fa fa-plus me-1"></i>
                                    Opret lokale
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-success nav-btn"
                                   asp-page="/SmartBoardPage/GetAllSmartBoards">
                                    <i class="fa fa-plus me-1"></i>
                                    Smartboards
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            @if (!User.Identity.IsAuthenticated || isHome)
                            {
                                <a class="btn login-btn" asp-page="/LogInPage/LogIn">
                                    <i class="fa fa-sign-in me-2"></i>
                                    Log ind
                                </a>
                            }
                            else
                            {
                                <form method="post" asp-page="/LogInPage/LogOut" class="d-inline">
                                    <button type="submit" class="btn logout-btn nav-btn">
                                        <i class="fa fa-sign-out me-2"></i>
                                        Log ud
                                    </button>
                                </form>
                            }
                        </li>



                    </ul>
                </div>
            </div>
        </nav>
    </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    <footer class="custom-footer">

            <div class="footer-left">
                <h5>Kontakt</h5>

            <p>
                <i class="fa fa-phone me-2"></i>

                <a href="tel:+4512345678">
                    +45 12 34 56 78
                </a>
            </p>

            <p>
                <i class="fa fa-envelope me-2"></i>

                <a href="mailto:kontakt@zealand.dk">
                    kontakt@zealand.dk
                </a>
            </p>
            </div>

        <div class="footer-right">

            <h5>Følg os</h5>

            <a href="https://www.linkedin.com/school/zealand---sj-llands-erhvervsakademi/"
               target="_blank">

                <i class="fa fa-linkedin-square"></i> LinkedIn
            </a>

            <br />

            <a href="https://www.instagram.com"
               target="_blank">

                <i class="fa fa-instagram"></i> Instagram
            </a>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
