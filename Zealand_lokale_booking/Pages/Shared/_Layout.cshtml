<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zealand_lokale_booking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lokalBooking.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zealand_lokale_booking.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
    <header>
        @{
            var isHome = Context.Request.Path == "/";   //er hjem?
        }
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ZealandLokaleBooking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="btn hjem-btn"
                               asp-area=""
                               asp-page="/Index">
                                Hjem
                            </a>
                        </li>

                    </ul>


                    <!-- RIGHT -->

                    <ul class="navbar-nav ms-auto d-flex flex-row gap-2 align-items-center">

                        @using System.Security.Claims

                        @{
                            var role = User.FindFirst(ClaimTypes.Role)?.Value;
                        }

                        @if (User.Identity.IsAuthenticated && !isHome)
                        {
                            <li class="nav-item">
                                <span class="nav-link fw-semibold text-primary">
                                    👤 @role
                                </span>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-success" asp-page="/UserPage/CreateUser">
                                        Create User
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="btn btn-warning" asp-page="/LokalePage/CreateLokale">
                                        Create Lokale
                                    </a>
                                </li>
                            }
                        }

                        <li class="nav-item mb-2">
                            @if (!User.Identity.IsAuthenticated || isHome)
                            {
                                <a class="btn login-btn" asp-page="/LogInPage/LogIn">
                                    Log ind
                                </a>
                            }
                            else
                            {
                                <form method="post" asp-page="/LogInPage/LogOut" class="d-inline">
                                    <button type="submit" class="btn logout-btn">
                                        Log ud
                                    </button>
                                </form>
                            }
                        </li>



                    </ul>
                </div>
            </div>
        </nav>
    </header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    <footer class="custom-footer">

            <div class="footer-left">
                <h5>Kontakt</h5>

                <p>
                    📞     <a href="tel:+4512345678">
                        +45 12 34 56 78
                    </a>
                </p>

                <p>
                    ✉️
                    <a href="mailto:kontakt@zealand.dk">
                        kontakt@zealand.dk
                    </a>
                </p>
            </div>

        <div class="footer-right">

            <h5>Følg os</h5>

            <a href="https://www.linkedin.com/school/zealand---sj-llands-erhvervsakademi/"
               target="_blank">

                <i class="fa fa-linkedin-square"></i> LinkedIn
            </a>

            <br />

            <a href="https://www.instagram.com"
               target="_blank">

                <i class="fa fa-instagram"></i> Instagram
            </a>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
