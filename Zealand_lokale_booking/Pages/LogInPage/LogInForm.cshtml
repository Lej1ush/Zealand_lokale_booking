@page
@model Zealand_lokale_booking.Pages.LogInPage.LogInFormModel
@{
}
<div class="login-wrapper">

    <div class="login-box">

        <h2 class="text-center mb-4">Log ind</h2>

        <div class="text-danger mb-3 text-center">
            @Model.Message
        </div>

        <form method="post">
            <input type="hidden" asp-for="Role" />  
            <div class="form-group mb-3">
                <label><i class="fa fa-envelope me-1"></i> Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="form-group mb-4">
                <label>
                    <i class="fa fa-lock me-1"></i>
                    Adgangskode
                </label>

                <div class="position-relative mb-3">
                    <input asp-for="Password"
                           type="password"
                           id="passwordField"                                                         @*  // giv navn for scripr *@
                           class="form-control" />

                    <i class="fa fa-eye password-eye"
                       onclick="togglePassword()"></i>                                                    @*   //klik *@
                </div>

                <script>
                    function togglePassword() {                                                                // Opretter funktionen
                        var password = document.getElementById("passwordField");

                        if (password.type === "password") {                                                   // Tjekker om password er skjult
                            password.type = "text";                                                             // Viser password
                        } else {
                            password.type = "password";                                                            // Skjuler password igen
                        }
                    }
                </script>
            </div>

            <button class="btn btn-warning w-100 mb-3">
                <i class="fa fa-sign-in-alt me-2"></i>
                Log ind
            </button>

            <div class="text-center">
                <a asp-page="/LogInPage/LogIn" class="btn btn-back">
                    <i class="fa fa-arrow-left me-1"></i>
                    Tilbage
                </a>
            </div>

        </form>

    </div>

</div>

