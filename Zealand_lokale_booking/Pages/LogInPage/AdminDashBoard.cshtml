@page
@model Zealand_lokale_booking.Pages.LogInPage.AdminDashBoardModel
@{
}
<div class="container">
    <div class="row g-4 justify-content-center">
        <div class="text-center page-header">
            <h1 class="dashboard-title">Administratorpanel</h1>
            <p class="sub-title">Vælg en funktion nedenfor</p>
        </div>
<div class="row g-4">

    <div class="col-12 col-md-6 col-lg-3">
        <a asp-page="/UserPage/GetAllUsers" class="dashboard-card dark">
            <div class="icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <h4>Alle brugere</h4>
            <p>Se alle brugere</p>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <a asp-page="/UserPage/GetAllUsers" asp-route-role="2" class="dashboard-card blue">
            <div class="icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h4>Studerende</h4>
            <p>Se alle studerende</p>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <a asp-page="/UserPage/GetAllUsers" asp-route-role="3" class="dashboard-card orange">
            <div class="icon">
                <i class="bi bi-person-workspace"></i>
            </div>
            <h4>Undervisere</h4>
            <p>Se alle undervisere</p>
        </a>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <a asp-page="/Roompage/GetAllRooms" class="dashboard-card green">
            <div class="icon">
                <i class="bi bi-building"></i>
            </div>
            <h4>Lokaler</h4>
            <p>Se alle lokaler</p>
        </a>
    </div>
            <div class="back-container">
                <a asp-page="/Index" class="btn btn-back">

                    <i class="fa fa-arrow-left me-1"></i>
                    Tilbage
                </a>
            </div>
</div>
    </div>
</div>