@page
@model Zealand_lokale_booking.Pages.LogInPage.LogInModel
@{
}
<div class="d-flex justify-content-center align-items-center"
     style="min-height:80vh;">
<div class="login-container">

    <h1>Zealand</h1>

    <div class="card">
        <strong>🔒 Admin og skemalæggere</strong><br />
        <span class="desc">
            Administratorer og planlæggere med klient bruger
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
           asp-route-role="Admin">
            Log ind
        </a>
    </div>

    <div class="card">
        <strong>🔒 Medarbejdere Zealand</strong><br />
        <span class="desc">
            Er du medarbejder eller underviser?
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
           asp-route-role="Teacher">
            Log ind
        </a>
    </div>

    <div class="card">
        <strong>🔒 Studerende Zealand</strong><br />
        <span class="desc">
            Er du studerende?
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
           asp-route-role="Student">
            Log ind
        </a>
    </div>

    <div class="back-container">
        <a asp-page="/Index" class="btn-back">
            Tilbage
        </a>
    </div>
</div>
</div>