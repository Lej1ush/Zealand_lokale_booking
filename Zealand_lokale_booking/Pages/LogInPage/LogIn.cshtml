@page
@model Zealand_lokale_booking.Pages.LogInPage.LogInModel
@{
}
<div class="d-flex justify-content-center align-items-center"
     style="min-height:80vh;">
<div class="login-container">

    <h1>Zealand</h1>

    <div class="card">
            <strong>
                <i class="fa fa-lock me-1"></i>
                Admin og skemalæggere
            </strong>
        <span class="desc">
                Administratorer og planlæggere med klientadgang
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
               asp-route-role="1">
                <i class="fa fa-sign-in-alt me-2"></i>
            Log ind
        </a>
    </div>

    <div class="card">
            <strong>   <i class="fa fa-lock me-1"></i> Medarbejdere Zealand</strong><br />
        <span class="desc">
            Er du medarbejder eller underviser?
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
               asp-route-role="3">
                <i class="fa fa-sign-in-alt me-2"></i>
            Log ind
        </a>
    </div>

    <div class="card">
            <strong>   <i class="fa fa-lock me-1"></i> Studerende Zealand</strong><br />
        <span class="desc">
            Er du studerende?
        </span><br />
        <a class="btn-login"
           asp-page="/LogInPage/LogInForm"
               asp-route-role="2">
                <i class="fa fa-sign-in-alt me-2"></i>
            Log ind
        </a>
    </div>

    <div class="back-container">
        <a asp-page="/Index" class="btn btn-back ">
                <i class="fa fa-arrow-left me-1"></i>
              Tilbage
        </a>
    </div>
</div>
</div>